# ---- LaTeX build artefacts -------------------------------------------------
# Regenerated by latexmk on every compile. The .tex and the final .pdf are
# source and deliverable; everything here is scratch.
*.aux
*.log
*.fls
*.fdb_latexmk
*.out
*.toc
*.synctex.gz
*.bbl
*.blg
*.nav
*.snm
*.vrb

# ---- editor backups --------------------------------------------------------
*.bak
*~

# ---- MATLAB ----------------------------------------------------------------
*.asv

# ---- IDE caches ------------------------------------------------------------
# .vscode/settings.json and c_cpp_properties.json stay tracked; the IntelliSense
# browse database is ~1 GB of machine-local index and must never be committed.
.vscode/browse.vc.db*
.vscode/ipch/

# ---- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
